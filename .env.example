# Copy this file to .env and fill in your values.
# Get your Amber token at https://app.amber.com.au/developers
#   (turn on Developer Mode, then "Generate a new token").
AMBER_API_TOKEN=replace_me

# Optional. If left blank, the script looks it up via the /sites endpoint.
AMBER_SITE_ID=

# Your AirTouch 2+ IP (set a DHCP reservation on your router so it stays fixed).
AIRTOUCH_HOST=192.168.1.100

# ---------------------------------------------------------------------------
# Monitor settings (used by monitor.py)
# ---------------------------------------------------------------------------

# Turn the heating OFF when the price reaches this many cents per kWh.
UPPER_THRESHOLD_C=100

# Turn the heating back ON once the price falls to this many cents per kWh.
# Must be below UPPER_THRESHOLD_C. The gap between the two is the hysteresis
# that stops the system flapping on and off around a single value.
# This is the one value not specified, defaulted to 80. Adjust to taste.
LOWER_THRESHOLD_C=80

# Also curtail whenever Amber flags the interval as a SPIKE, even if the price
# is below UPPER_THRESHOLD_C. (POTENTIAL spikes are ignored.)
TRIGGER_ON_SPIKE=true

# Price interval resolution in minutes: 5 or 30. Use 5 so the monitor sees the
# same live price the Amber app shows and that 5-minute settlement charges.
# Leaving this at your account default (often 30) can read very differently
# from the app during volatile periods.
PRICE_RESOLUTION_MINUTES=5

# How often to check the price, in seconds. Amber updates every 5 minutes;
# 120s is responsive and well within the API rate limit.
POLL_INTERVAL_SECONDS=120

# Minimum minutes between switching actions, to protect the compressor.
COOLDOWN_MINUTES=15

# Forecast-aware restore. Before turning heating back on, look this many
# upcoming Amber forecast intervals ahead. If any is at/above UPPER_THRESHOLD_C
# or is flagged as a SPIKE or POTENTIAL spike, keep the heating off rather than
# restoring it straight into another expensive period.
FORECAST_RESTORE_GUARD=true
FORECAST_LOOKAHEAD=3

# Mode to set when turning the AC back on. Leave blank to preserve the AC's
# existing mode (recommended if you run it in AUTO). Set to HEAT, COOL, AUTO,
# DRY or FAN only if you want to force a specific mode on restore.
RESTORE_MODE=

# SAFETY: when true, the monitor logs what it WOULD do but never switches the
# AC. Leave this on for a day to watch it, then set to false to go live.
DRY_RUN=true

# Where to keep the persisted state and the audit log.
STATE_FILE=monitor_state.json
LOG_FILE=monitor.log

# The airtouch2 library logs a harmless, recoverable WARNING with a stack trace
# when the unit sends an unrecognised message type (e.g. 0x27). Default ERROR
# hides it. Set to WARNING or DEBUG only if you need to troubleshoot the AC link.
AIRTOUCH_LOG_LEVEL=ERROR
